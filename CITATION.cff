cff-version: 1.2.0
message: "Si utilizas este software, cítalo con estos metadatos."
title: "Pipeline de Análisis Normativo Automatizado"
type: software
authors:
  - family-names: "Freire Ferrando"
    given-names: "Manuel"
    affiliation: "Universidad de Granada"
    orcid: "https://orcid.org/0009-0008-8593-7324"
version: "1.0.0"
